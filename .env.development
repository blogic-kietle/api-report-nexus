# Copy to .env.<APP_ENV> (e.g. .env.development) — those files are git-ignored.
APP_ENV=development
PORT=8000
LOG_LEVEL=info                 # debug | info | warn | error
MAX_JSON_BODY=20971520         # 20MB, same as the Node express.json limit
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=30s

# PDF rendering goes through Gotenberg: `docker compose up gotenberg` publishes it on localhost:3000
# for `make run`; docker-compose overrides this with http://gotenberg:3000 inside the network.
GOTENBERG_URL=http://localhost:3000
PDF_RENDER_TIMEOUT=5m
MAX_CHUNK_SIZE=5242880         # 5MB per upload chunk
PDF_CHUNK_SIZE=1000            # rows per rendered page before the PDF is split and merged
PDF_STREAM_SESSION_TTL=30m
PDF_STREAM_FINALIZE_TIMEOUT=30m

# Mail goes out through the License API; unset disables the send-email routes.
LICENSE_API_URL=http://192.168.1.194:5000/api
LICENSE_API_TIMEOUT=60s
BLOGIC_VIEW_CLIENT_URL=https://blogicview.com   # receipt links in the sales summary

# RabbitMQ hears about every delivery fee statement sent; unset host disables it.
# Same names as the Node .env. Certificates are mounted, never copied into the image.
RABBITMQ_HOST=
RABBITMQ_PORT=5671
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_VHOST=/
RABBITMQ_CERT_PATH=./certs/BlogicsClient.p12   # empty = plain AMQP, local brokers only
RABBITMQ_CERT_PASS=
RABBITMQ_CA_PATH=./certs/ca.crt
RABBITMQ_SERVER_NAME=BlogicSystemsMQ           # SNI, when it differs from RABBITMQ_HOST
RABBITMQ_PUBLISH_TIMEOUT=10s
